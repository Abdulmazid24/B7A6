    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.3",
    "stripe": "^22.3.2",
    "tsx": "^4.23.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
