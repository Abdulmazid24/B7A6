            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if(res.success && res.data && res.data.tuitionFees && res.data.tuitionFees.length > 0) {",
                  "  pm.environment.set('tuitionFeeId', res.data.tuitionFees[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
